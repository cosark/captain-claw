<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Hud" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
    </style>

    <style name="Hud.Button" parent="android:Widget.Material.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:backgroundTint">@color/surface</item>
    </style>

    <style name="Hud.Button.Primary">
        <item name="android:textColor">@color/accent_ink</item>
        <item name="android:backgroundTint">@color/accent</item>
    </style>
</resources>
